{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Light Terracotta Atelier",
  "type": "light",
  "colors": {
    "foreground": "#47342D",
    "focusBorder": "#9B4934AA",
    "selection.background": "#EED5C6",
    "descriptionForeground": "#7D6256",
    "errorForeground": "#A23953",
    "editor.background": "#FFF6EF",
    "editor.foreground": "#47342D",
    "editorCursor.foreground": "#9B4934",
    "editor.selectionBackground": "#EED5C6",
    "editor.inactiveSelectionBackground": "#EED5C688",
    "editor.selectionHighlightBackground": "#EED5C666",
    "editor.wordHighlightBackground": "#EED5C655",
    "editor.wordHighlightStrongBackground": "#9B493433",
    "editor.findMatchBackground": "#F3D793",
    "editor.findMatchHighlightBackground": "#F7E9BC",
    "editor.lineHighlightBackground": "#F8EAE0",
    "editorLineNumber.foreground": "#7D6256",
    "editorLineNumber.activeForeground": "#9B4934",
    "editorIndentGuide.background1": "#D9BFAE",
    "editorIndentGuide.activeBackground1": "#9B4934",
    "editorRuler.foreground": "#D9BFAE",
    "editorBracketMatch.background": "#9B493422",
    "editorBracketMatch.border": "#9B4934",
    "editorGutter.modifiedBackground": "#2C619C",
    "editorGutter.addedBackground": "#326A49",
    "editorGutter.deletedBackground": "#A23953",
    "sideBar.background": "#F1DED0",
    "sideBar.foreground": "#47342D",
    "sideBarTitle.foreground": "#47342D",
    "sideBarSectionHeader.background": "#F8EAE0",
    "sideBarSectionHeader.foreground": "#47342D",
    "activityBar.background": "#E5C4AF",
    "activityBar.foreground": "#47342D",
    "activityBar.inactiveForeground": "#7D6256",
    "activityBarBadge.background": "#9B4934",
    "activityBarBadge.foreground": "#FFFFFF",
    "statusBar.background": "#9B4934",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#9B4934",
    "statusBar.debuggingBackground": "#7D3928",
    "titleBar.activeBackground": "#F8EAE0",
    "titleBar.activeForeground": "#47342D",
    "titleBar.inactiveBackground": "#F8EAE0",
    "titleBar.inactiveForeground": "#7D6256",
    "tab.activeBackground": "#FFF6EF",
    "tab.activeForeground": "#47342D",
    "tab.inactiveBackground": "#F8EAE0",
    "tab.inactiveForeground": "#7D6256",
    "tab.border": "#D9BFAE",
    "tab.activeBorderTop": "#9B4934",
    "panel.background": "#F8EAE0",
    "panel.border": "#D9BFAE",
    "panelTitle.activeForeground": "#9B4934",
    "panelTitle.inactiveForeground": "#7D6256",
    "terminal.background": "#FFF6EF",
    "terminal.foreground": "#47342D",
    "terminal.ansiBlack": "#47342D",
    "terminal.ansiRed": "#A23953",
    "terminal.ansiGreen": "#326A49",
    "terminal.ansiYellow": "#796017",
    "terminal.ansiBlue": "#2C619C",
    "terminal.ansiMagenta": "#7B4086",
    "terminal.ansiCyan": "#236D7A",
    "terminal.ansiWhite": "#FFF6EF",
    "terminal.ansiBrightBlack": "#7D6256",
    "terminal.ansiBrightRed": "#A23953",
    "terminal.ansiBrightGreen": "#326A49",
    "terminal.ansiBrightYellow": "#796017",
    "terminal.ansiBrightBlue": "#2C619C",
    "terminal.ansiBrightMagenta": "#7B4086",
    "terminal.ansiBrightCyan": "#236D7A",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "input.background": "#F8EAE0",
    "input.foreground": "#47342D",
    "input.border": "#D9BFAE",
    "dropdown.background": "#F8EAE0",
    "dropdown.foreground": "#47342D",
    "dropdown.border": "#D9BFAE",
    "list.activeSelectionBackground": "#EED5C6",
    "list.activeSelectionForeground": "#47342D",
    "list.inactiveSelectionBackground": "#EED5C699",
    "list.hoverBackground": "#F8EAE0",
    "quickInput.background": "#FFF6EF",
    "quickInput.foreground": "#47342D",
    "button.background": "#9B4934",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#7D3928",
    "statusBar.debuggingForeground": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7D6256",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#326A49"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#9B4934"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#2C619C"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#47342D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#796017"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#66529B"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#A23953"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8B512B"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#236D7A"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#A23953"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#A23953"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#326A49"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#326A49"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#675B73"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#A23953"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#66529B",
    "interface": "#66529B",
    "enum": "#66529B",
    "function": "#2C619C",
    "method": "#2C619C",
    "property": "#8B512B",
    "variable.readonly": "#796017",
    "parameter": "#47342D",
    "keyword": "#9B4934"
  }
}
