{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Light Wisteria Paper",
  "type": "light",
  "colors": {
    "foreground": "#323654",
    "focusBorder": "#7C83E6AA",
    "selection.background": "#C9C7F4",
    "descriptionForeground": "#8F829C",
    "errorForeground": "#BF5D7A",
    "editor.background": "#F3F2FF",
    "editor.foreground": "#323654",
    "editorCursor.foreground": "#7C83E6",
    "editor.selectionBackground": "#C9C7F4",
    "editor.inactiveSelectionBackground": "#C9C7F488",
    "editor.selectionHighlightBackground": "#C9C7F466",
    "editor.wordHighlightBackground": "#C9C7F455",
    "editor.wordHighlightStrongBackground": "#7C83E633",
    "editor.findMatchBackground": "#F3D793",
    "editor.findMatchHighlightBackground": "#F7E9BC",
    "editor.lineHighlightBackground": "#EDEBFF",
    "editorLineNumber.foreground": "#9A8BA8",
    "editorLineNumber.activeForeground": "#7C83E6",
    "editorIndentGuide.background1": "#C9C7E8",
    "editorIndentGuide.activeBackground1": "#7C83E6",
    "editorRuler.foreground": "#C9C7E8",
    "editorBracketMatch.background": "#7C83E622",
    "editorBracketMatch.border": "#7C83E6",
    "editorGutter.modifiedBackground": "#3F78D8",
    "editorGutter.addedBackground": "#4C8D70",
    "editorGutter.deletedBackground": "#BF5D7A",
    "sideBar.background": "#DDDAF3",
    "sideBar.foreground": "#323654",
    "sideBarTitle.foreground": "#323654",
    "sideBarSectionHeader.background": "#E7E6FA",
    "sideBarSectionHeader.foreground": "#323654",
    "activityBar.background": "#BAB8E8",
    "activityBar.foreground": "#323654",
    "activityBar.inactiveForeground": "#8F829C",
    "activityBarBadge.background": "#7C83E6",
    "activityBarBadge.foreground": "#FFFFFF",
    "statusBar.background": "#7C83E6",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#7C83E6",
    "statusBar.debuggingBackground": "#A68CF4",
    "titleBar.activeBackground": "#E7E6FA",
    "titleBar.activeForeground": "#323654",
    "titleBar.inactiveBackground": "#E7E6FA",
    "titleBar.inactiveForeground": "#8F829C",
    "tab.activeBackground": "#F3F2FF",
    "tab.activeForeground": "#323654",
    "tab.inactiveBackground": "#E7E6FA",
    "tab.inactiveForeground": "#8F829C",
    "tab.border": "#C9C7E8",
    "tab.activeBorderTop": "#7C83E6",
    "panel.background": "#E7E6FA",
    "panel.border": "#C9C7E8",
    "panelTitle.activeForeground": "#7C83E6",
    "panelTitle.inactiveForeground": "#8F829C",
    "terminal.background": "#F3F2FF",
    "terminal.foreground": "#323654",
    "terminal.ansiBlack": "#323654",
    "terminal.ansiRed": "#BF5D7A",
    "terminal.ansiGreen": "#4C8D70",
    "terminal.ansiYellow": "#A17B1D",
    "terminal.ansiBlue": "#3F78D8",
    "terminal.ansiMagenta": "#7C83E6",
    "terminal.ansiCyan": "#388A9E",
    "terminal.ansiWhite": "#F3F2FF",
    "terminal.ansiBrightBlack": "#8F829C",
    "terminal.ansiBrightRed": "#BF5D7A",
    "terminal.ansiBrightGreen": "#4C8D70",
    "terminal.ansiBrightYellow": "#A17B1D",
    "terminal.ansiBrightBlue": "#3F78D8",
    "terminal.ansiBrightMagenta": "#A68CF4",
    "terminal.ansiBrightCyan": "#388A9E",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "input.background": "#FFFFFFAA",
    "input.foreground": "#323654",
    "input.border": "#C9C7E8",
    "dropdown.background": "#FFFFFFAA",
    "dropdown.foreground": "#323654",
    "dropdown.border": "#C9C7E8",
    "list.activeSelectionBackground": "#C9C7F4",
    "list.activeSelectionForeground": "#323654",
    "list.inactiveSelectionBackground": "#C9C7F499",
    "list.hoverBackground": "#EDEBFF",
    "quickInput.background": "#F3F2FF",
    "quickInput.foreground": "#323654",
    "button.background": "#7C83E6",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#A68CF4"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8F829C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4C8D70"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#7C83E6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#3F78D8"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#323654"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#A17B1D"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#656BD9"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#BF5D7A"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#B4703D"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#388A9E"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#BF5D7A"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#BF5D7A"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#4C8D70"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#4C8D70"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#675B73"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#BF5D7A"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#A17B1D"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7C83E6"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4C8D70"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#BF5D7A"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#B4703D"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#656BD9",
    "interface": "#656BD9",
    "enum": "#656BD9",
    "function": "#3F78D8",
    "method": "#3F78D8",
    "property": "#B4703D",
    "variable.readonly": "#A17B1D",
    "parameter": "#323654",
    "keyword": "#7C83E6"
  }
}
