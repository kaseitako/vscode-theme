{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Twinkle Mauve",
  "type": "dark",
  "colors": {
    "foreground": "#E8DDE9",
    "focusBorder": "#E0B5E5AA",
    "selection.background": "#614F6F",
    "descriptionForeground": "#ADA0B2",
    "errorForeground": "#ECA5B0",
    "editor.background": "#302734",
    "editor.foreground": "#E8DDE9",
    "editorCursor.foreground": "#E0B5E5",
    "editor.selectionBackground": "#614F6F",
    "editor.inactiveSelectionBackground": "#614F6F88",
    "editor.selectionHighlightBackground": "#614F6F66",
    "editor.wordHighlightBackground": "#614F6F55",
    "editor.wordHighlightStrongBackground": "#E0B5E544",
    "editor.findMatchBackground": "#6A5A3D",
    "editor.findMatchHighlightBackground": "#4E4230",
    "editor.lineHighlightBackground": "#3A3041",
    "editorLineNumber.foreground": "#81778F",
    "editorLineNumber.activeForeground": "#CFC5DF",
    "editorIndentGuide.background1": "#463D55",
    "editorIndentGuide.activeBackground1": "#8D7DA5",
    "editorRuler.foreground": "#463D55",
    "editorBracketMatch.background": "#E0B5E530",
    "editorBracketMatch.border": "#E0B5E5",
    "editorGutter.modifiedBackground": "#AFC7ED",
    "editorGutter.addedBackground": "#BBD5AE",
    "editorGutter.deletedBackground": "#ECA5B0",
    "sideBar.background": "#29212D",
    "sideBar.foreground": "#E8DDE9",
    "sideBarTitle.foreground": "#F8F1FF",
    "sideBarSectionHeader.background": "#3A3041",
    "sideBarSectionHeader.foreground": "#F2ECFA",
    "activityBar.background": "#241D28",
    "activityBar.foreground": "#E0B5E5",
    "activityBar.inactiveForeground": "#ADA0B2",
    "activityBarBadge.background": "#E0B5E5",
    "activityBarBadge.foreground": "#302734",
    "statusBar.background": "#614F6F",
    "statusBar.foreground": "#FFF7FF",
    "statusBar.noFolderBackground": "#614F6F",
    "statusBar.debuggingBackground": "#8A6DA1",
    "titleBar.activeBackground": "#241D28",
    "titleBar.activeForeground": "#FFF7FF",
    "titleBar.inactiveBackground": "#241D28",
    "titleBar.inactiveForeground": "#ADA0B2",
    "tab.activeBackground": "#302734",
    "tab.activeForeground": "#FFF7FF",
    "tab.inactiveBackground": "#241D28",
    "tab.inactiveForeground": "#ADA0B2",
    "tab.border": "#241D28",
    "tab.activeBorderTop": "#E0B5E5",
    "panel.background": "#29212D",
    "panel.border": "#463D55",
    "panelTitle.activeForeground": "#E0B5E5",
    "panelTitle.inactiveForeground": "#ADA0B2",
    "terminal.background": "#29212D",
    "terminal.foreground": "#E8DDE9",
    "terminal.ansiBlack": "#302734",
    "terminal.ansiRed": "#ECA5B0",
    "terminal.ansiGreen": "#BBD5AE",
    "terminal.ansiYellow": "#EBD7A0",
    "terminal.ansiBlue": "#AFC7ED",
    "terminal.ansiMagenta": "#E0B5E5",
    "terminal.ansiCyan": "#AAD5D9",
    "terminal.ansiWhite": "#E8DDE9",
    "terminal.ansiBrightBlack": "#756D83",
    "terminal.ansiBrightRed": "#ECA5B0",
    "terminal.ansiBrightGreen": "#BBD5AE",
    "terminal.ansiBrightYellow": "#EBD7A0",
    "terminal.ansiBrightBlue": "#AFC7ED",
    "terminal.ansiBrightMagenta": "#F1C5D8",
    "terminal.ansiBrightCyan": "#AAD5D9",
    "terminal.ansiBrightWhite": "#FFF7FF",
    "input.background": "#3A3041",
    "input.foreground": "#FFF7FF",
    "input.border": "#5A4D69",
    "dropdown.background": "#3A3041",
    "dropdown.foreground": "#FFF7FF",
    "dropdown.border": "#5A4D69",
    "list.activeSelectionBackground": "#614F6F",
    "list.activeSelectionForeground": "#FFF7FF",
    "list.inactiveSelectionBackground": "#614F6F99",
    "list.hoverBackground": "#3A3041",
    "quickInput.background": "#302734",
    "quickInput.foreground": "#E8DDE9",
    "button.background": "#E0B5E5",
    "button.foreground": "#302734",
    "button.hoverBackground": "#F1C5D8"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ADA0B2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#BBD5AE"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#E0B5E5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#AFC7ED"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E8DDE9"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#EBD7A0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#D8B4E8"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#ECA5B0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#EBC09A"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#AAD5D9"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ECA5B0"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#ECA5B0"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#BBD5AE"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#BBD5AE"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C8BED7"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#302734",
        "background": "#ECA5B0"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#EBD7A0"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#E0B5E5"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#BBD5AE"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ECA5B0"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#EBC09A"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#D8B4E8",
    "interface": "#D8B4E8",
    "enum": "#D8B4E8",
    "function": "#AFC7ED",
    "method": "#AFC7ED",
    "property": "#EBC09A",
    "variable.readonly": "#EBD7A0",
    "parameter": "#E8DDE9",
    "keyword": "#E0B5E5"
  }
}
