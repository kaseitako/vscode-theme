{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Sugar Plum",
  "type": "dark",
  "colors": {
    "foreground": "#E8DCEF",
    "focusBorder": "#DCA8F2AA",
    "selection.background": "#624777",
    "descriptionForeground": "#AD9AB8",
    "errorForeground": "#EAA0B1",
    "editor.background": "#312438",
    "editor.foreground": "#E8DCEF",
    "editorCursor.foreground": "#DCA8F2",
    "editor.selectionBackground": "#624777",
    "editor.inactiveSelectionBackground": "#62477788",
    "editor.selectionHighlightBackground": "#62477766",
    "editor.wordHighlightBackground": "#62477755",
    "editor.wordHighlightStrongBackground": "#DCA8F244",
    "editor.findMatchBackground": "#6A5A3D",
    "editor.findMatchHighlightBackground": "#4E4230",
    "editor.lineHighlightBackground": "#3B2B44",
    "editorLineNumber.foreground": "#81778F",
    "editorLineNumber.activeForeground": "#CFC5DF",
    "editorIndentGuide.background1": "#463D55",
    "editorIndentGuide.activeBackground1": "#8D7DA5",
    "editorRuler.foreground": "#463D55",
    "editorBracketMatch.background": "#DCA8F230",
    "editorBracketMatch.border": "#DCA8F2",
    "editorGutter.modifiedBackground": "#A9C3F3",
    "editorGutter.addedBackground": "#B9D4AA",
    "editorGutter.deletedBackground": "#EAA0B1",
    "sideBar.background": "#2A1F31",
    "sideBar.foreground": "#E8DCEF",
    "sideBarTitle.foreground": "#F8F1FF",
    "sideBarSectionHeader.background": "#3B2B44",
    "sideBarSectionHeader.foreground": "#F2ECFA",
    "activityBar.background": "#251B2C",
    "activityBar.foreground": "#DCA8F2",
    "activityBar.inactiveForeground": "#AD9AB8",
    "activityBarBadge.background": "#DCA8F2",
    "activityBarBadge.foreground": "#312438",
    "statusBar.background": "#624777",
    "statusBar.foreground": "#FFF7FF",
    "statusBar.noFolderBackground": "#624777",
    "statusBar.debuggingBackground": "#8A6DA1",
    "titleBar.activeBackground": "#251B2C",
    "titleBar.activeForeground": "#FFF7FF",
    "titleBar.inactiveBackground": "#251B2C",
    "titleBar.inactiveForeground": "#AD9AB8",
    "tab.activeBackground": "#312438",
    "tab.activeForeground": "#FFF7FF",
    "tab.inactiveBackground": "#251B2C",
    "tab.inactiveForeground": "#AD9AB8",
    "tab.border": "#251B2C",
    "tab.activeBorderTop": "#DCA8F2",
    "panel.background": "#2A1F31",
    "panel.border": "#463D55",
    "panelTitle.activeForeground": "#DCA8F2",
    "panelTitle.inactiveForeground": "#AD9AB8",
    "terminal.background": "#2A1F31",
    "terminal.foreground": "#E8DCEF",
    "terminal.ansiBlack": "#312438",
    "terminal.ansiRed": "#EAA0B1",
    "terminal.ansiGreen": "#B9D4AA",
    "terminal.ansiYellow": "#E7D292",
    "terminal.ansiBlue": "#A9C3F3",
    "terminal.ansiMagenta": "#DCA8F2",
    "terminal.ansiCyan": "#A4D3D8",
    "terminal.ansiWhite": "#E8DCEF",
    "terminal.ansiBrightBlack": "#756D83",
    "terminal.ansiBrightRed": "#EAA0B1",
    "terminal.ansiBrightGreen": "#B9D4AA",
    "terminal.ansiBrightYellow": "#E7D292",
    "terminal.ansiBrightBlue": "#A9C3F3",
    "terminal.ansiBrightMagenta": "#F0B8E3",
    "terminal.ansiBrightCyan": "#A4D3D8",
    "terminal.ansiBrightWhite": "#FFF7FF",
    "input.background": "#3B2B44",
    "input.foreground": "#FFF7FF",
    "input.border": "#5A4D69",
    "dropdown.background": "#3B2B44",
    "dropdown.foreground": "#FFF7FF",
    "dropdown.border": "#5A4D69",
    "list.activeSelectionBackground": "#624777",
    "list.activeSelectionForeground": "#FFF7FF",
    "list.inactiveSelectionBackground": "#62477799",
    "list.hoverBackground": "#3B2B44",
    "quickInput.background": "#312438",
    "quickInput.foreground": "#E8DCEF",
    "button.background": "#DCA8F2",
    "button.foreground": "#312438",
    "button.hoverBackground": "#F0B8E3"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AD9AB8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#B9D4AA"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#DCA8F2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#A9C3F3"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E8DCEF"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E7D292"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#D1B0F3"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#EAA0B1"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E9B78E"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#A4D3D8"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#EAA0B1"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#EAA0B1"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#B9D4AA"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#B9D4AA"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C8BED7"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#312438",
        "background": "#EAA0B1"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#E7D292"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#DCA8F2"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#B9D4AA"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EAA0B1"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E9B78E"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#D1B0F3",
    "interface": "#D1B0F3",
    "enum": "#D1B0F3",
    "function": "#A9C3F3",
    "method": "#A9C3F3",
    "property": "#E9B78E",
    "variable.readonly": "#E7D292",
    "parameter": "#E8DCEF",
    "keyword": "#DCA8F2"
  }
}
