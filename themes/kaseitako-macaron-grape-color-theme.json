{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Macaron Grape",
  "type": "dark",
  "colors": {
    "foreground": "#E7E0EF",
    "focusBorder": "#D5B7F5AA",
    "selection.background": "#5B4E77",
    "descriptionForeground": "#AAA0BA",
    "errorForeground": "#EDA7B4",
    "editor.background": "#2E273B",
    "editor.foreground": "#E7E0EF",
    "editorCursor.foreground": "#D5B7F5",
    "editor.selectionBackground": "#5B4E77",
    "editor.inactiveSelectionBackground": "#5B4E7788",
    "editor.selectionHighlightBackground": "#5B4E7766",
    "editor.wordHighlightBackground": "#5B4E7755",
    "editor.wordHighlightStrongBackground": "#D5B7F544",
    "editor.findMatchBackground": "#6A5A3D",
    "editor.findMatchHighlightBackground": "#4E4230",
    "editor.lineHighlightBackground": "#383047",
    "editorLineNumber.foreground": "#81778F",
    "editorLineNumber.activeForeground": "#CFC5DF",
    "editorIndentGuide.background1": "#463D55",
    "editorIndentGuide.activeBackground1": "#8D7DA5",
    "editorRuler.foreground": "#463D55",
    "editorBracketMatch.background": "#D5B7F530",
    "editorBracketMatch.border": "#D5B7F5",
    "editorGutter.modifiedBackground": "#ADC7F0",
    "editorGutter.addedBackground": "#BED7AF",
    "editorGutter.deletedBackground": "#EDA7B4",
    "sideBar.background": "#282233",
    "sideBar.foreground": "#E7E0EF",
    "sideBarTitle.foreground": "#F8F1FF",
    "sideBarSectionHeader.background": "#383047",
    "sideBarSectionHeader.foreground": "#F2ECFA",
    "activityBar.background": "#231E2E",
    "activityBar.foreground": "#D5B7F5",
    "activityBar.inactiveForeground": "#AAA0BA",
    "activityBarBadge.background": "#D5B7F5",
    "activityBarBadge.foreground": "#2E273B",
    "statusBar.background": "#5B4E77",
    "statusBar.foreground": "#FFF7FF",
    "statusBar.noFolderBackground": "#5B4E77",
    "statusBar.debuggingBackground": "#8A6DA1",
    "titleBar.activeBackground": "#231E2E",
    "titleBar.activeForeground": "#FFF7FF",
    "titleBar.inactiveBackground": "#231E2E",
    "titleBar.inactiveForeground": "#AAA0BA",
    "tab.activeBackground": "#2E273B",
    "tab.activeForeground": "#FFF7FF",
    "tab.inactiveBackground": "#231E2E",
    "tab.inactiveForeground": "#AAA0BA",
    "tab.border": "#231E2E",
    "tab.activeBorderTop": "#D5B7F5",
    "panel.background": "#282233",
    "panel.border": "#463D55",
    "panelTitle.activeForeground": "#D5B7F5",
    "panelTitle.inactiveForeground": "#AAA0BA",
    "terminal.background": "#282233",
    "terminal.foreground": "#E7E0EF",
    "terminal.ansiBlack": "#2E273B",
    "terminal.ansiRed": "#EDA7B4",
    "terminal.ansiGreen": "#BED7AF",
    "terminal.ansiYellow": "#EAD89E",
    "terminal.ansiBlue": "#ADC7F0",
    "terminal.ansiMagenta": "#D5B7F5",
    "terminal.ansiCyan": "#A8D6D6",
    "terminal.ansiWhite": "#E7E0EF",
    "terminal.ansiBrightBlack": "#756D83",
    "terminal.ansiBrightRed": "#EDA7B4",
    "terminal.ansiBrightGreen": "#BED7AF",
    "terminal.ansiBrightYellow": "#EAD89E",
    "terminal.ansiBrightBlue": "#ADC7F0",
    "terminal.ansiBrightMagenta": "#F0C2DD",
    "terminal.ansiBrightCyan": "#A8D6D6",
    "terminal.ansiBrightWhite": "#FFF7FF",
    "input.background": "#383047",
    "input.foreground": "#FFF7FF",
    "input.border": "#5A4D69",
    "dropdown.background": "#383047",
    "dropdown.foreground": "#FFF7FF",
    "dropdown.border": "#5A4D69",
    "list.activeSelectionBackground": "#5B4E77",
    "list.activeSelectionForeground": "#FFF7FF",
    "list.inactiveSelectionBackground": "#5B4E7799",
    "list.hoverBackground": "#383047",
    "quickInput.background": "#2E273B",
    "quickInput.foreground": "#E7E0EF",
    "button.background": "#D5B7F5",
    "button.foreground": "#2E273B",
    "button.hoverBackground": "#F0C2DD"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AAA0BA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#BED7AF"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#D5B7F5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#ADC7F0"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E7E0EF"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#EAD89E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#CAB8F7"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#EDA7B4"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E8BE97"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#A8D6D6"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#EDA7B4"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#EDA7B4"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#BED7AF"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#BED7AF"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C8BED7"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#2E273B",
        "background": "#EDA7B4"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#EAD89E"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D5B7F5"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#BED7AF"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EDA7B4"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E8BE97"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#CAB8F7",
    "interface": "#CAB8F7",
    "enum": "#CAB8F7",
    "function": "#ADC7F0",
    "method": "#ADC7F0",
    "property": "#E8BE97",
    "variable.readonly": "#EAD89E",
    "parameter": "#E7E0EF",
    "keyword": "#D5B7F5"
  }
}
