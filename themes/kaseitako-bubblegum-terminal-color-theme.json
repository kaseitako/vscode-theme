{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Bubblegum Terminal",
  "type": "dark",
  "colors": {
    "foreground": "#F0E2F0",
    "focusBorder": "#F0A7D8AA",
    "selection.background": "#664471",
    "descriptionForeground": "#8A8195",
    "errorForeground": "#F09AAD",
    "editor.background": "#251B2A",
    "editor.foreground": "#F0E2F0",
    "editorCursor.foreground": "#F0A7D8",
    "editor.selectionBackground": "#664471",
    "editor.inactiveSelectionBackground": "#66447188",
    "editor.selectionHighlightBackground": "#66447166",
    "editor.wordHighlightBackground": "#66447155",
    "editor.wordHighlightStrongBackground": "#F0A7D833",
    "editor.findMatchBackground": "#6A5638",
    "editor.findMatchHighlightBackground": "#4D3F2B",
    "editor.lineHighlightBackground": "#35263D",
    "editorLineNumber.foreground": "#8A8195",
    "editorLineNumber.activeForeground": "#F0A7D8",
    "editorIndentGuide.background1": "#523B5E",
    "editorIndentGuide.activeBackground1": "#F0A7D8",
    "editorRuler.foreground": "#523B5E",
    "editorBracketMatch.background": "#F0A7D822",
    "editorBracketMatch.border": "#F0A7D8",
    "editorGutter.modifiedBackground": "#A8C2FF",
    "editorGutter.addedBackground": "#A9D8B8",
    "editorGutter.deletedBackground": "#F09AAD",
    "sideBar.background": "#2D2034",
    "sideBar.foreground": "#F0E2F0",
    "sideBarTitle.foreground": "#F0E2F0",
    "sideBarSectionHeader.background": "#1E1623",
    "sideBarSectionHeader.foreground": "#F0E2F0",
    "activityBar.background": "#160F1B",
    "activityBar.foreground": "#F0A7D8",
    "activityBar.inactiveForeground": "#8A8195",
    "activityBarBadge.background": "#F0A7D8",
    "activityBarBadge.foreground": "#251B2A",
    "statusBar.background": "#F0A7D8",
    "statusBar.foreground": "#251B2A",
    "statusBar.noFolderBackground": "#F0A7D8",
    "statusBar.debuggingBackground": "#B7A2FF",
    "titleBar.activeBackground": "#1E1623",
    "titleBar.activeForeground": "#F0E2F0",
    "titleBar.inactiveBackground": "#1E1623",
    "titleBar.inactiveForeground": "#8A8195",
    "tab.activeBackground": "#251B2A",
    "tab.activeForeground": "#F0E2F0",
    "tab.inactiveBackground": "#1E1623",
    "tab.inactiveForeground": "#8A8195",
    "tab.border": "#523B5E",
    "tab.activeBorderTop": "#F0A7D8",
    "panel.background": "#1E1623",
    "panel.border": "#523B5E",
    "panelTitle.activeForeground": "#F0A7D8",
    "panelTitle.inactiveForeground": "#8A8195",
    "terminal.background": "#251B2A",
    "terminal.foreground": "#F0E2F0",
    "terminal.ansiBlack": "#F0E2F0",
    "terminal.ansiRed": "#F09AAD",
    "terminal.ansiGreen": "#A9D8B8",
    "terminal.ansiYellow": "#E9D98D",
    "terminal.ansiBlue": "#A8C2FF",
    "terminal.ansiMagenta": "#F0A7D8",
    "terminal.ansiCyan": "#93D8E2",
    "terminal.ansiWhite": "#251B2A",
    "terminal.ansiBrightBlack": "#8A8195",
    "terminal.ansiBrightRed": "#F09AAD",
    "terminal.ansiBrightGreen": "#A9D8B8",
    "terminal.ansiBrightYellow": "#E9D98D",
    "terminal.ansiBrightBlue": "#A8C2FF",
    "terminal.ansiBrightMagenta": "#B7A2FF",
    "terminal.ansiBrightCyan": "#93D8E2",
    "terminal.ansiBrightWhite": "#F7F3FF",
    "input.background": "#35263D",
    "input.foreground": "#F0E2F0",
    "input.border": "#523B5E",
    "dropdown.background": "#35263D",
    "dropdown.foreground": "#F0E2F0",
    "dropdown.border": "#523B5E",
    "list.activeSelectionBackground": "#664471",
    "list.activeSelectionForeground": "#F0E2F0",
    "list.inactiveSelectionBackground": "#66447199",
    "list.hoverBackground": "#35263D",
    "quickInput.background": "#251B2A",
    "quickInput.foreground": "#F0E2F0",
    "button.background": "#F0A7D8",
    "button.foreground": "#251B2A",
    "button.hoverBackground": "#B7A2FF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8195",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A9D8B8"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#F0A7D8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#A8C2FF"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F0E2F0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E9D98D"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#D3B4FF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F09AAD"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E8B17F"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#93D8E2"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#F09AAD"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#F09AAD"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#A9D8B8"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#A9D8B8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#BEB4C9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#251B2A",
        "background": "#F09AAD"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#D3B4FF",
    "interface": "#D3B4FF",
    "enum": "#D3B4FF",
    "function": "#A8C2FF",
    "method": "#A8C2FF",
    "property": "#E8B17F",
    "variable.readonly": "#E9D98D",
    "parameter": "#F0E2F0",
    "keyword": "#F0A7D8"
  }
}
