{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Cyber Marshmallow",
  "type": "dark",
  "colors": {
    "foreground": "#E8EAF8",
    "focusBorder": "#9EA8FFAA",
    "selection.background": "#4C5488",
    "descriptionForeground": "#8A8195",
    "errorForeground": "#F09AAD",
    "editor.background": "#1D1E2F",
    "editor.foreground": "#E8EAF8",
    "editorCursor.foreground": "#9EA8FF",
    "editor.selectionBackground": "#4C5488",
    "editor.inactiveSelectionBackground": "#4C548888",
    "editor.selectionHighlightBackground": "#4C548866",
    "editor.wordHighlightBackground": "#4C548855",
    "editor.wordHighlightStrongBackground": "#9EA8FF33",
    "editor.findMatchBackground": "#6A5638",
    "editor.findMatchHighlightBackground": "#4D3F2B",
    "editor.lineHighlightBackground": "#292C45",
    "editorLineNumber.foreground": "#8A8195",
    "editorLineNumber.activeForeground": "#9EA8FF",
    "editorIndentGuide.background1": "#3E4268",
    "editorIndentGuide.activeBackground1": "#9EA8FF",
    "editorRuler.foreground": "#3E4268",
    "editorBracketMatch.background": "#9EA8FF22",
    "editorBracketMatch.border": "#9EA8FF",
    "editorGutter.modifiedBackground": "#8DB4FF",
    "editorGutter.addedBackground": "#9FDCB8",
    "editorGutter.deletedBackground": "#F09AAD",
    "sideBar.background": "#24263A",
    "sideBar.foreground": "#E8EAF8",
    "sideBarTitle.foreground": "#E8EAF8",
    "sideBarSectionHeader.background": "#171829",
    "sideBarSectionHeader.foreground": "#E8EAF8",
    "activityBar.background": "#10111F",
    "activityBar.foreground": "#9EA8FF",
    "activityBar.inactiveForeground": "#8A8195",
    "activityBarBadge.background": "#9EA8FF",
    "activityBarBadge.foreground": "#1D1E2F",
    "statusBar.background": "#9EA8FF",
    "statusBar.foreground": "#1D1E2F",
    "statusBar.noFolderBackground": "#9EA8FF",
    "statusBar.debuggingBackground": "#F2A7E8",
    "titleBar.activeBackground": "#171829",
    "titleBar.activeForeground": "#E8EAF8",
    "titleBar.inactiveBackground": "#171829",
    "titleBar.inactiveForeground": "#8A8195",
    "tab.activeBackground": "#1D1E2F",
    "tab.activeForeground": "#E8EAF8",
    "tab.inactiveBackground": "#171829",
    "tab.inactiveForeground": "#8A8195",
    "tab.border": "#3E4268",
    "tab.activeBorderTop": "#9EA8FF",
    "panel.background": "#171829",
    "panel.border": "#3E4268",
    "panelTitle.activeForeground": "#9EA8FF",
    "panelTitle.inactiveForeground": "#8A8195",
    "terminal.background": "#1D1E2F",
    "terminal.foreground": "#E8EAF8",
    "terminal.ansiBlack": "#E8EAF8",
    "terminal.ansiRed": "#F09AAD",
    "terminal.ansiGreen": "#9FDCB8",
    "terminal.ansiYellow": "#E9D98A",
    "terminal.ansiBlue": "#8DB4FF",
    "terminal.ansiMagenta": "#9EA8FF",
    "terminal.ansiCyan": "#8DE3E4",
    "terminal.ansiWhite": "#1D1E2F",
    "terminal.ansiBrightBlack": "#8A8195",
    "terminal.ansiBrightRed": "#F09AAD",
    "terminal.ansiBrightGreen": "#9FDCB8",
    "terminal.ansiBrightYellow": "#E9D98A",
    "terminal.ansiBrightBlue": "#8DB4FF",
    "terminal.ansiBrightMagenta": "#F2A7E8",
    "terminal.ansiBrightCyan": "#8DE3E4",
    "terminal.ansiBrightWhite": "#F7F3FF",
    "input.background": "#292C45",
    "input.foreground": "#E8EAF8",
    "input.border": "#3E4268",
    "dropdown.background": "#292C45",
    "dropdown.foreground": "#E8EAF8",
    "dropdown.border": "#3E4268",
    "list.activeSelectionBackground": "#4C5488",
    "list.activeSelectionForeground": "#E8EAF8",
    "list.inactiveSelectionBackground": "#4C548899",
    "list.hoverBackground": "#292C45",
    "quickInput.background": "#1D1E2F",
    "quickInput.foreground": "#E8EAF8",
    "button.background": "#9EA8FF",
    "button.foreground": "#1D1E2F",
    "button.hoverBackground": "#F2A7E8"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8195",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#9FDCB8"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#9EA8FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8DB4FF"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E8EAF8"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E9D98A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#C5B0FF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F09AAD"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E9B67F"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#8DE3E4"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#F09AAD"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#F09AAD"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#9FDCB8"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#9FDCB8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#BEB4C9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1D1E2F",
        "background": "#F09AAD"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#C5B0FF",
    "interface": "#C5B0FF",
    "enum": "#C5B0FF",
    "function": "#8DB4FF",
    "method": "#8DB4FF",
    "property": "#E9B67F",
    "variable.readonly": "#E9D98A",
    "parameter": "#E8EAF8",
    "keyword": "#9EA8FF"
  }
}
