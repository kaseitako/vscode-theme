{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Business Magical Girl",
  "type": "dark",
  "colors": {
    "foreground": "#E7E1EF",
    "focusBorder": "#D9A7F2AA",
    "selection.background": "#5A4D74",
    "descriptionForeground": "#8A8195",
    "errorForeground": "#EA9BAE",
    "editor.background": "#25232E",
    "editor.foreground": "#E7E1EF",
    "editorCursor.foreground": "#D9A7F2",
    "editor.selectionBackground": "#5A4D74",
    "editor.inactiveSelectionBackground": "#5A4D7488",
    "editor.selectionHighlightBackground": "#5A4D7466",
    "editor.wordHighlightBackground": "#5A4D7455",
    "editor.wordHighlightStrongBackground": "#D9A7F233",
    "editor.findMatchBackground": "#6A5638",
    "editor.findMatchHighlightBackground": "#4D3F2B",
    "editor.lineHighlightBackground": "#312E3F",
    "editorLineNumber.foreground": "#8A8195",
    "editorLineNumber.activeForeground": "#D9A7F2",
    "editorIndentGuide.background1": "#4A445C",
    "editorIndentGuide.activeBackground1": "#D9A7F2",
    "editorRuler.foreground": "#4A445C",
    "editorBracketMatch.background": "#D9A7F222",
    "editorBracketMatch.border": "#D9A7F2",
    "editorGutter.modifiedBackground": "#A6C4F2",
    "editorGutter.addedBackground": "#B6D6AE",
    "editorGutter.deletedBackground": "#EA9BAE",
    "sideBar.background": "#2A2735",
    "sideBar.foreground": "#E7E1EF",
    "sideBarTitle.foreground": "#E7E1EF",
    "sideBarSectionHeader.background": "#1F1D28",
    "sideBarSectionHeader.foreground": "#E7E1EF",
    "activityBar.background": "#17151F",
    "activityBar.foreground": "#D9A7F2",
    "activityBar.inactiveForeground": "#8A8195",
    "activityBarBadge.background": "#D9A7F2",
    "activityBarBadge.foreground": "#25232E",
    "statusBar.background": "#D9A7F2",
    "statusBar.foreground": "#25232E",
    "statusBar.noFolderBackground": "#D9A7F2",
    "statusBar.debuggingBackground": "#F0B8D8",
    "titleBar.activeBackground": "#1F1D28",
    "titleBar.activeForeground": "#E7E1EF",
    "titleBar.inactiveBackground": "#1F1D28",
    "titleBar.inactiveForeground": "#8A8195",
    "tab.activeBackground": "#25232E",
    "tab.activeForeground": "#E7E1EF",
    "tab.inactiveBackground": "#1F1D28",
    "tab.inactiveForeground": "#8A8195",
    "tab.border": "#4A445C",
    "tab.activeBorderTop": "#D9A7F2",
    "panel.background": "#1F1D28",
    "panel.border": "#4A445C",
    "panelTitle.activeForeground": "#D9A7F2",
    "panelTitle.inactiveForeground": "#8A8195",
    "terminal.background": "#25232E",
    "terminal.foreground": "#E7E1EF",
    "terminal.ansiBlack": "#E7E1EF",
    "terminal.ansiRed": "#EA9BAE",
    "terminal.ansiGreen": "#B6D6AE",
    "terminal.ansiYellow": "#E5D28E",
    "terminal.ansiBlue": "#A6C4F2",
    "terminal.ansiMagenta": "#D9A7F2",
    "terminal.ansiCyan": "#9FD4D8",
    "terminal.ansiWhite": "#25232E",
    "terminal.ansiBrightBlack": "#8A8195",
    "terminal.ansiBrightRed": "#EA9BAE",
    "terminal.ansiBrightGreen": "#B6D6AE",
    "terminal.ansiBrightYellow": "#E5D28E",
    "terminal.ansiBrightBlue": "#A6C4F2",
    "terminal.ansiBrightMagenta": "#F0B8D8",
    "terminal.ansiBrightCyan": "#9FD4D8",
    "terminal.ansiBrightWhite": "#F7F3FF",
    "input.background": "#312E3F",
    "input.foreground": "#E7E1EF",
    "input.border": "#4A445C",
    "dropdown.background": "#312E3F",
    "dropdown.foreground": "#E7E1EF",
    "dropdown.border": "#4A445C",
    "list.activeSelectionBackground": "#5A4D74",
    "list.activeSelectionForeground": "#E7E1EF",
    "list.inactiveSelectionBackground": "#5A4D7499",
    "list.hoverBackground": "#312E3F",
    "quickInput.background": "#25232E",
    "quickInput.foreground": "#E7E1EF",
    "button.background": "#D9A7F2",
    "button.foreground": "#25232E",
    "button.hoverBackground": "#F0B8D8"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8195",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#B6D6AE"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#D9A7F2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#A6C4F2"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E7E1EF"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E5D28E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#C5B2F5"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#EA9BAE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E8B48A"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#9FD4D8"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#EA9BAE"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#EA9BAE"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#B6D6AE"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#B6D6AE"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#BEB4C9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#25232E",
        "background": "#EA9BAE"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#C5B2F5",
    "interface": "#C5B2F5",
    "enum": "#C5B2F5",
    "function": "#A6C4F2",
    "method": "#A6C4F2",
    "property": "#E8B48A",
    "variable.readonly": "#E5D28E",
    "parameter": "#E7E1EF",
    "keyword": "#D9A7F2"
  }
}
