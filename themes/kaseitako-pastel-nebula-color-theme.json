{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Pastel Nebula",
  "type": "dark",
  "colors": {
    "foreground": "#DEE2F1",
    "focusBorder": "#BEBBFFAA",
    "selection.background": "#4E5278",
    "descriptionForeground": "#9BA2B8",
    "errorForeground": "#E4A6BF",
    "editor.background": "#252638",
    "editor.foreground": "#DEE2F1",
    "editorCursor.foreground": "#BEBBFF",
    "editor.selectionBackground": "#4E5278",
    "editor.inactiveSelectionBackground": "#4E527888",
    "editor.selectionHighlightBackground": "#4E527866",
    "editor.wordHighlightBackground": "#4E527855",
    "editor.wordHighlightStrongBackground": "#BEBBFF44",
    "editor.findMatchBackground": "#6A5A3D",
    "editor.findMatchHighlightBackground": "#4E4230",
    "editor.lineHighlightBackground": "#2E3047",
    "editorLineNumber.foreground": "#81778F",
    "editorLineNumber.activeForeground": "#CFC5DF",
    "editorIndentGuide.background1": "#463D55",
    "editorIndentGuide.activeBackground1": "#8D7DA5",
    "editorRuler.foreground": "#463D55",
    "editorBracketMatch.background": "#BEBBFF30",
    "editorBracketMatch.border": "#BEBBFF",
    "editorGutter.modifiedBackground": "#9FCBFA",
    "editorGutter.addedBackground": "#B4D8C0",
    "editorGutter.deletedBackground": "#E4A6BF",
    "sideBar.background": "#202132",
    "sideBar.foreground": "#DEE2F1",
    "sideBarTitle.foreground": "#F8F1FF",
    "sideBarSectionHeader.background": "#2E3047",
    "sideBarSectionHeader.foreground": "#F2ECFA",
    "activityBar.background": "#1C1D2D",
    "activityBar.foreground": "#BEBBFF",
    "activityBar.inactiveForeground": "#9BA2B8",
    "activityBarBadge.background": "#BEBBFF",
    "activityBarBadge.foreground": "#252638",
    "statusBar.background": "#4E5278",
    "statusBar.foreground": "#FFF7FF",
    "statusBar.noFolderBackground": "#4E5278",
    "statusBar.debuggingBackground": "#8A6DA1",
    "titleBar.activeBackground": "#1C1D2D",
    "titleBar.activeForeground": "#FFF7FF",
    "titleBar.inactiveBackground": "#1C1D2D",
    "titleBar.inactiveForeground": "#9BA2B8",
    "tab.activeBackground": "#252638",
    "tab.activeForeground": "#FFF7FF",
    "tab.inactiveBackground": "#1C1D2D",
    "tab.inactiveForeground": "#9BA2B8",
    "tab.border": "#1C1D2D",
    "tab.activeBorderTop": "#BEBBFF",
    "panel.background": "#202132",
    "panel.border": "#463D55",
    "panelTitle.activeForeground": "#BEBBFF",
    "panelTitle.inactiveForeground": "#9BA2B8",
    "terminal.background": "#202132",
    "terminal.foreground": "#DEE2F1",
    "terminal.ansiBlack": "#252638",
    "terminal.ansiRed": "#E4A6BF",
    "terminal.ansiGreen": "#B4D8C0",
    "terminal.ansiYellow": "#E4DCA5",
    "terminal.ansiBlue": "#9FCBFA",
    "terminal.ansiMagenta": "#BEBBFF",
    "terminal.ansiCyan": "#98D9E5",
    "terminal.ansiWhite": "#DEE2F1",
    "terminal.ansiBrightBlack": "#756D83",
    "terminal.ansiBrightRed": "#E4A6BF",
    "terminal.ansiBrightGreen": "#B4D8C0",
    "terminal.ansiBrightYellow": "#E4DCA5",
    "terminal.ansiBrightBlue": "#9FCBFA",
    "terminal.ansiBrightMagenta": "#E2C6F2",
    "terminal.ansiBrightCyan": "#98D9E5",
    "terminal.ansiBrightWhite": "#FFF7FF",
    "input.background": "#2E3047",
    "input.foreground": "#FFF7FF",
    "input.border": "#5A4D69",
    "dropdown.background": "#2E3047",
    "dropdown.foreground": "#FFF7FF",
    "dropdown.border": "#5A4D69",
    "list.activeSelectionBackground": "#4E5278",
    "list.activeSelectionForeground": "#FFF7FF",
    "list.inactiveSelectionBackground": "#4E527899",
    "list.hoverBackground": "#2E3047",
    "quickInput.background": "#252638",
    "quickInput.foreground": "#DEE2F1",
    "button.background": "#BEBBFF",
    "button.foreground": "#252638",
    "button.hoverBackground": "#E2C6F2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9BA2B8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#B4D8C0"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#BEBBFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9FCBFA"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DEE2F1"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E4DCA5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#AFC1F9"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#E4A6BF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E6C09E"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#98D9E5"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#E4A6BF"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#E4A6BF"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#B4D8C0"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#B4D8C0"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C8BED7"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#252638",
        "background": "#E4A6BF"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#E4DCA5"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#BEBBFF"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#B4D8C0"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E4A6BF"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E6C09E"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#AFC1F9",
    "interface": "#AFC1F9",
    "enum": "#AFC1F9",
    "function": "#9FCBFA",
    "method": "#9FCBFA",
    "property": "#E6C09E",
    "variable.readonly": "#E4DCA5",
    "parameter": "#DEE2F1",
    "keyword": "#BEBBFF"
  }
}
