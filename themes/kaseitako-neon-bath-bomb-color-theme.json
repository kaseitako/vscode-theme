{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Neon Bath Bomb",
  "type": "dark",
  "colors": {
    "foreground": "#E1EDF4",
    "focusBorder": "#9AD8FFAA",
    "selection.background": "#4F6A8B",
    "descriptionForeground": "#8A8195",
    "errorForeground": "#F0A0B8",
    "editor.background": "#1C2430",
    "editor.foreground": "#E1EDF4",
    "editorCursor.foreground": "#9AD8FF",
    "editor.selectionBackground": "#4F6A8B",
    "editor.inactiveSelectionBackground": "#4F6A8B88",
    "editor.selectionHighlightBackground": "#4F6A8B66",
    "editor.wordHighlightBackground": "#4F6A8B55",
    "editor.wordHighlightStrongBackground": "#9AD8FF33",
    "editor.findMatchBackground": "#6A5638",
    "editor.findMatchHighlightBackground": "#4D3F2B",
    "editor.lineHighlightBackground": "#293A4F",
    "editorLineNumber.foreground": "#8A8195",
    "editorLineNumber.activeForeground": "#9AD8FF",
    "editorIndentGuide.background1": "#3F5874",
    "editorIndentGuide.activeBackground1": "#9AD8FF",
    "editorRuler.foreground": "#3F5874",
    "editorBracketMatch.background": "#9AD8FF22",
    "editorBracketMatch.border": "#9AD8FF",
    "editorGutter.modifiedBackground": "#9AD8FF",
    "editorGutter.addedBackground": "#A8E0BF",
    "editorGutter.deletedBackground": "#F0A0B8",
    "sideBar.background": "#223143",
    "sideBar.foreground": "#E1EDF4",
    "sideBarTitle.foreground": "#E1EDF4",
    "sideBarSectionHeader.background": "#16202B",
    "sideBarSectionHeader.foreground": "#E1EDF4",
    "activityBar.background": "#101823",
    "activityBar.foreground": "#9AD8FF",
    "activityBar.inactiveForeground": "#8A8195",
    "activityBarBadge.background": "#9AD8FF",
    "activityBarBadge.foreground": "#1C2430",
    "statusBar.background": "#9AD8FF",
    "statusBar.foreground": "#1C2430",
    "statusBar.noFolderBackground": "#9AD8FF",
    "statusBar.debuggingBackground": "#F5A8D8",
    "titleBar.activeBackground": "#16202B",
    "titleBar.activeForeground": "#E1EDF4",
    "titleBar.inactiveBackground": "#16202B",
    "titleBar.inactiveForeground": "#8A8195",
    "tab.activeBackground": "#1C2430",
    "tab.activeForeground": "#E1EDF4",
    "tab.inactiveBackground": "#16202B",
    "tab.inactiveForeground": "#8A8195",
    "tab.border": "#3F5874",
    "tab.activeBorderTop": "#9AD8FF",
    "panel.background": "#16202B",
    "panel.border": "#3F5874",
    "panelTitle.activeForeground": "#9AD8FF",
    "panelTitle.inactiveForeground": "#8A8195",
    "terminal.background": "#1C2430",
    "terminal.foreground": "#E1EDF4",
    "terminal.ansiBlack": "#E1EDF4",
    "terminal.ansiRed": "#F0A0B8",
    "terminal.ansiGreen": "#A8E0BF",
    "terminal.ansiYellow": "#E9D989",
    "terminal.ansiBlue": "#9AD8FF",
    "terminal.ansiMagenta": "#9AD8FF",
    "terminal.ansiCyan": "#8FE8E4",
    "terminal.ansiWhite": "#1C2430",
    "terminal.ansiBrightBlack": "#8A8195",
    "terminal.ansiBrightRed": "#F0A0B8",
    "terminal.ansiBrightGreen": "#A8E0BF",
    "terminal.ansiBrightYellow": "#E9D989",
    "terminal.ansiBrightBlue": "#9AD8FF",
    "terminal.ansiBrightMagenta": "#F5A8D8",
    "terminal.ansiBrightCyan": "#8FE8E4",
    "terminal.ansiBrightWhite": "#F7F3FF",
    "input.background": "#293A4F",
    "input.foreground": "#E1EDF4",
    "input.border": "#3F5874",
    "dropdown.background": "#293A4F",
    "dropdown.foreground": "#E1EDF4",
    "dropdown.border": "#3F5874",
    "list.activeSelectionBackground": "#4F6A8B",
    "list.activeSelectionForeground": "#E1EDF4",
    "list.inactiveSelectionBackground": "#4F6A8B99",
    "list.hoverBackground": "#293A4F",
    "quickInput.background": "#1C2430",
    "quickInput.foreground": "#E1EDF4",
    "button.background": "#9AD8FF",
    "button.foreground": "#1C2430",
    "button.hoverBackground": "#F5A8D8"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8195",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A8E0BF"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#9AD8FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9AD8FF"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E1EDF4"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E9D989"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#C7B4FF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F0A0B8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E8B47E"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#8FE8E4"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#F0A0B8"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#F0A0B8"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#A8E0BF"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#A8E0BF"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#BEB4C9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#1C2430",
        "background": "#F0A0B8"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#C7B4FF",
    "interface": "#C7B4FF",
    "enum": "#C7B4FF",
    "function": "#9AD8FF",
    "method": "#9AD8FF",
    "property": "#E8B47E",
    "variable.readonly": "#E9D989",
    "parameter": "#E1EDF4",
    "keyword": "#9AD8FF"
  }
}
