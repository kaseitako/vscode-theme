{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Hologram Sticker",
  "type": "light",
  "colors": {
    "foreground": "#30344A",
    "focusBorder": "#8D7CFFAA",
    "selection.background": "#D8CCFF",
    "descriptionForeground": "#8E8094",
    "errorForeground": "#C35D7A",
    "editor.background": "#F9F7FF",
    "editor.foreground": "#30344A",
    "editorCursor.foreground": "#8D7CFF",
    "editor.selectionBackground": "#D8CCFF",
    "editor.inactiveSelectionBackground": "#D8CCFF88",
    "editor.selectionHighlightBackground": "#D8CCFF66",
    "editor.wordHighlightBackground": "#D8CCFF55",
    "editor.wordHighlightStrongBackground": "#8D7CFF33",
    "editor.findMatchBackground": "#F3D793",
    "editor.findMatchHighlightBackground": "#F7E9BC",
    "editor.lineHighlightBackground": "#F1EDFF",
    "editorLineNumber.foreground": "#8E8094",
    "editorLineNumber.activeForeground": "#8D7CFF",
    "editorIndentGuide.background1": "#D2C7F5",
    "editorIndentGuide.activeBackground1": "#8D7CFF",
    "editorRuler.foreground": "#D2C7F5",
    "editorBracketMatch.background": "#8D7CFF22",
    "editorBracketMatch.border": "#8D7CFF",
    "editorGutter.modifiedBackground": "#4E7DDE",
    "editorGutter.addedBackground": "#4F8E78",
    "editorGutter.deletedBackground": "#C35D7A",
    "sideBar.background": "#E7DAFF",
    "sideBar.foreground": "#30344A",
    "sideBarTitle.foreground": "#30344A",
    "sideBarSectionHeader.background": "#EEF2FF",
    "sideBarSectionHeader.foreground": "#30344A",
    "activityBar.background": "#BFD8FF",
    "activityBar.foreground": "#30344A",
    "activityBar.inactiveForeground": "#8E8094",
    "activityBarBadge.background": "#8D7CFF",
    "activityBarBadge.foreground": "#FFFFFF",
    "statusBar.background": "#8D7CFF",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#8D7CFF",
    "statusBar.debuggingBackground": "#FFB7DD",
    "titleBar.activeBackground": "#EEF2FF",
    "titleBar.activeForeground": "#30344A",
    "titleBar.inactiveBackground": "#EEF2FF",
    "titleBar.inactiveForeground": "#8E8094",
    "tab.activeBackground": "#F9F7FF",
    "tab.activeForeground": "#30344A",
    "tab.inactiveBackground": "#EEF2FF",
    "tab.inactiveForeground": "#8E8094",
    "tab.border": "#D2C7F5",
    "tab.activeBorderTop": "#8D7CFF",
    "panel.background": "#EEF2FF",
    "panel.border": "#D2C7F5",
    "panelTitle.activeForeground": "#8D7CFF",
    "panelTitle.inactiveForeground": "#8E8094",
    "terminal.background": "#F9F7FF",
    "terminal.foreground": "#30344A",
    "terminal.ansiBlack": "#30344A",
    "terminal.ansiRed": "#C35D7A",
    "terminal.ansiGreen": "#4F8E78",
    "terminal.ansiYellow": "#9B7C1C",
    "terminal.ansiBlue": "#4E7DDE",
    "terminal.ansiMagenta": "#8D7CFF",
    "terminal.ansiCyan": "#3E8F9F",
    "terminal.ansiWhite": "#F9F7FF",
    "terminal.ansiBrightBlack": "#8E8094",
    "terminal.ansiBrightRed": "#C35D7A",
    "terminal.ansiBrightGreen": "#4F8E78",
    "terminal.ansiBrightYellow": "#9B7C1C",
    "terminal.ansiBrightBlue": "#4E7DDE",
    "terminal.ansiBrightMagenta": "#FFB7DD",
    "terminal.ansiBrightCyan": "#3E8F9F",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "input.background": "#FFFFFFAA",
    "input.foreground": "#30344A",
    "input.border": "#D2C7F5",
    "dropdown.background": "#FFFFFFAA",
    "dropdown.foreground": "#30344A",
    "dropdown.border": "#D2C7F5",
    "list.activeSelectionBackground": "#D8CCFF",
    "list.activeSelectionForeground": "#30344A",
    "list.inactiveSelectionBackground": "#D8CCFF99",
    "list.hoverBackground": "#F1EDFF",
    "quickInput.background": "#F9F7FF",
    "quickInput.foreground": "#30344A",
    "button.background": "#8D7CFF",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#FFB7DD"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8E8094",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4F8E78"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#8D7CFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4E7DDE"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#30344A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#9B7C1C"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#7F72DE"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#C35D7A"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#B87040"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#3E8F9F"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#C35D7A"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#C35D7A"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#4F8E78"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#4F8E78"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#675B73"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#C35D7A"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#7F72DE",
    "interface": "#7F72DE",
    "enum": "#7F72DE",
    "function": "#4E7DDE",
    "method": "#4E7DDE",
    "property": "#B87040",
    "variable.readonly": "#9B7C1C",
    "parameter": "#30344A",
    "keyword": "#8D7CFF"
  }
}
