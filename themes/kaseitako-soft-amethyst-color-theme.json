{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Soft Amethyst",
  "type": "dark",
  "colors": {
    "foreground": "#E5DDEE",
    "focusBorder": "#D2ADEFAA",
    "selection.background": "#5C4A72",
    "descriptionForeground": "#A79AB8",
    "errorForeground": "#E8A2B0",
    "editor.background": "#2C2438",
    "editor.foreground": "#E5DDEE",
    "editorCursor.foreground": "#D2ADEF",
    "editor.selectionBackground": "#5C4A72",
    "editor.inactiveSelectionBackground": "#5C4A7288",
    "editor.selectionHighlightBackground": "#5C4A7266",
    "editor.wordHighlightBackground": "#5C4A7255",
    "editor.wordHighlightStrongBackground": "#D2ADEF44",
    "editor.findMatchBackground": "#6A5A3D",
    "editor.findMatchHighlightBackground": "#4E4230",
    "editor.lineHighlightBackground": "#372D45",
    "editorLineNumber.foreground": "#81778F",
    "editorLineNumber.activeForeground": "#CFC5DF",
    "editorIndentGuide.background1": "#463D55",
    "editorIndentGuide.activeBackground1": "#8D7DA5",
    "editorRuler.foreground": "#463D55",
    "editorBracketMatch.background": "#D2ADEF30",
    "editorBracketMatch.border": "#D2ADEF",
    "editorGutter.modifiedBackground": "#A8C5EF",
    "editorGutter.addedBackground": "#B8D6AD",
    "editorGutter.deletedBackground": "#E8A2B0",
    "sideBar.background": "#261F31",
    "sideBar.foreground": "#E5DDEE",
    "sideBarTitle.foreground": "#F8F1FF",
    "sideBarSectionHeader.background": "#372D45",
    "sideBarSectionHeader.foreground": "#F2ECFA",
    "activityBar.background": "#211B2C",
    "activityBar.foreground": "#D2ADEF",
    "activityBar.inactiveForeground": "#A79AB8",
    "activityBarBadge.background": "#D2ADEF",
    "activityBarBadge.foreground": "#2C2438",
    "statusBar.background": "#5C4A72",
    "statusBar.foreground": "#FFF7FF",
    "statusBar.noFolderBackground": "#5C4A72",
    "statusBar.debuggingBackground": "#8A6DA1",
    "titleBar.activeBackground": "#211B2C",
    "titleBar.activeForeground": "#FFF7FF",
    "titleBar.inactiveBackground": "#211B2C",
    "titleBar.inactiveForeground": "#A79AB8",
    "tab.activeBackground": "#2C2438",
    "tab.activeForeground": "#FFF7FF",
    "tab.inactiveBackground": "#211B2C",
    "tab.inactiveForeground": "#A79AB8",
    "tab.border": "#211B2C",
    "tab.activeBorderTop": "#D2ADEF",
    "panel.background": "#261F31",
    "panel.border": "#463D55",
    "panelTitle.activeForeground": "#D2ADEF",
    "panelTitle.inactiveForeground": "#A79AB8",
    "terminal.background": "#261F31",
    "terminal.foreground": "#E5DDEE",
    "terminal.ansiBlack": "#2C2438",
    "terminal.ansiRed": "#E8A2B0",
    "terminal.ansiGreen": "#B8D6AD",
    "terminal.ansiYellow": "#E8D59A",
    "terminal.ansiBlue": "#A8C5EF",
    "terminal.ansiMagenta": "#D2ADEF",
    "terminal.ansiCyan": "#A3D6D8",
    "terminal.ansiWhite": "#E5DDEE",
    "terminal.ansiBrightBlack": "#756D83",
    "terminal.ansiBrightRed": "#E8A2B0",
    "terminal.ansiBrightGreen": "#B8D6AD",
    "terminal.ansiBrightYellow": "#E8D59A",
    "terminal.ansiBrightBlue": "#A8C5EF",
    "terminal.ansiBrightMagenta": "#EDC1E5",
    "terminal.ansiBrightCyan": "#A3D6D8",
    "terminal.ansiBrightWhite": "#FFF7FF",
    "input.background": "#372D45",
    "input.foreground": "#FFF7FF",
    "input.border": "#5A4D69",
    "dropdown.background": "#372D45",
    "dropdown.foreground": "#FFF7FF",
    "dropdown.border": "#5A4D69",
    "list.activeSelectionBackground": "#5C4A72",
    "list.activeSelectionForeground": "#FFF7FF",
    "list.inactiveSelectionBackground": "#5C4A7299",
    "list.hoverBackground": "#372D45",
    "quickInput.background": "#2C2438",
    "quickInput.foreground": "#E5DDEE",
    "button.background": "#D2ADEF",
    "button.foreground": "#2C2438",
    "button.hoverBackground": "#EDC1E5"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A79AB8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#B8D6AD"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#D2ADEF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#A8C5EF"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E5DDEE"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E8D59A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#C6AAEF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#E8A2B0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E8BA93"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#A3D6D8"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#E8A2B0"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#E8A2B0"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#B8D6AD"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#B8D6AD"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#C8BED7"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#2C2438",
        "background": "#E8A2B0"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#E8D59A"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D2ADEF"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#B8D6AD"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E8A2B0"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E8BA93"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#C6AAEF",
    "interface": "#C6AAEF",
    "enum": "#C6AAEF",
    "function": "#A8C5EF",
    "method": "#A8C5EF",
    "property": "#E8BA93",
    "variable.readonly": "#E8D59A",
    "parameter": "#E5DDEE",
    "keyword": "#D2ADEF"
  }
}
