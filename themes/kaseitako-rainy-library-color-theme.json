{
  "$schema": "vscode://schemas/color-theme",
  "name": "Kaseitako Rainy Library",
  "type": "dark",
  "colors": {
    "foreground": "#D8DEE6",
    "focusBorder": "#8FB7C7AA",
    "selection.background": "#3F5564",
    "descriptionForeground": "#8A8195",
    "errorForeground": "#D99AA6",
    "editor.background": "#20262D",
    "editor.foreground": "#D8DEE6",
    "editorCursor.foreground": "#8FB7C7",
    "editor.selectionBackground": "#3F5564",
    "editor.inactiveSelectionBackground": "#3F556488",
    "editor.selectionHighlightBackground": "#3F556466",
    "editor.wordHighlightBackground": "#3F556455",
    "editor.wordHighlightStrongBackground": "#8FB7C733",
    "editor.findMatchBackground": "#6A5638",
    "editor.findMatchHighlightBackground": "#4D3F2B",
    "editor.lineHighlightBackground": "#2A333D",
    "editorLineNumber.foreground": "#8A8195",
    "editorLineNumber.activeForeground": "#8FB7C7",
    "editorIndentGuide.background1": "#3A4652",
    "editorIndentGuide.activeBackground1": "#8FB7C7",
    "editorRuler.foreground": "#3A4652",
    "editorBracketMatch.background": "#8FB7C722",
    "editorBracketMatch.border": "#8FB7C7",
    "editorGutter.modifiedBackground": "#8DB6E8",
    "editorGutter.addedBackground": "#A9C7A6",
    "editorGutter.deletedBackground": "#D99AA6",
    "sideBar.background": "#222B33",
    "sideBar.foreground": "#D8DEE6",
    "sideBarTitle.foreground": "#D8DEE6",
    "sideBarSectionHeader.background": "#1A2027",
    "sideBarSectionHeader.foreground": "#D8DEE6",
    "activityBar.background": "#151B21",
    "activityBar.foreground": "#8FB7C7",
    "activityBar.inactiveForeground": "#8A8195",
    "activityBarBadge.background": "#8FB7C7",
    "activityBarBadge.foreground": "#20262D",
    "statusBar.background": "#8FB7C7",
    "statusBar.foreground": "#20262D",
    "statusBar.noFolderBackground": "#8FB7C7",
    "statusBar.debuggingBackground": "#B7C8D0",
    "titleBar.activeBackground": "#1A2027",
    "titleBar.activeForeground": "#D8DEE6",
    "titleBar.inactiveBackground": "#1A2027",
    "titleBar.inactiveForeground": "#8A8195",
    "tab.activeBackground": "#20262D",
    "tab.activeForeground": "#D8DEE6",
    "tab.inactiveBackground": "#1A2027",
    "tab.inactiveForeground": "#8A8195",
    "tab.border": "#3A4652",
    "tab.activeBorderTop": "#8FB7C7",
    "panel.background": "#1A2027",
    "panel.border": "#3A4652",
    "panelTitle.activeForeground": "#8FB7C7",
    "panelTitle.inactiveForeground": "#8A8195",
    "terminal.background": "#20262D",
    "terminal.foreground": "#D8DEE6",
    "terminal.ansiBlack": "#D8DEE6",
    "terminal.ansiRed": "#D99AA6",
    "terminal.ansiGreen": "#A9C7A6",
    "terminal.ansiYellow": "#D7C28A",
    "terminal.ansiBlue": "#8DB6E8",
    "terminal.ansiMagenta": "#8FB7C7",
    "terminal.ansiCyan": "#8FCBD0",
    "terminal.ansiWhite": "#20262D",
    "terminal.ansiBrightBlack": "#8A8195",
    "terminal.ansiBrightRed": "#D99AA6",
    "terminal.ansiBrightGreen": "#A9C7A6",
    "terminal.ansiBrightYellow": "#D7C28A",
    "terminal.ansiBrightBlue": "#8DB6E8",
    "terminal.ansiBrightMagenta": "#B7C8D0",
    "terminal.ansiBrightCyan": "#8FCBD0",
    "terminal.ansiBrightWhite": "#F7F3FF",
    "input.background": "#2A333D",
    "input.foreground": "#D8DEE6",
    "input.border": "#3A4652",
    "dropdown.background": "#2A333D",
    "dropdown.foreground": "#D8DEE6",
    "dropdown.border": "#3A4652",
    "list.activeSelectionBackground": "#3F5564",
    "list.activeSelectionForeground": "#D8DEE6",
    "list.inactiveSelectionBackground": "#3F556499",
    "list.hoverBackground": "#2A333D",
    "quickInput.background": "#20262D",
    "quickInput.foreground": "#D8DEE6",
    "button.background": "#8FB7C7",
    "button.foreground": "#20262D",
    "button.hoverBackground": "#B7C8D0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8195",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#A9C7A6"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#8FB7C7"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8DB6E8"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D8DEE6"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#D7C28A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#9FB8D7"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#D99AA6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D7AA82"
      }
    },
    {
      "scope": [
        "support",
        "support.type",
        "support.class",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#8FCBD0"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#D99AA6"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > string.quoted.json > punctuation.string",
        "support.type.property-name.json punctuation"
      ],
      "settings": {
        "foreground": "#D99AA6"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json",
        "source.json meta.structure.array.json > value.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#A9C7A6"
      }
    },
    {
      "scope": [
        "source.json meta.structure.dictionary.json > value.json > string.quoted.json > punctuation",
        "source.json meta.structure.array.json > value.json > string.quoted.json > punctuation",
        "string.quoted.double punctuation"
      ],
      "settings": {
        "foreground": "#A9C7A6"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#BEB4C9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#20262D",
        "background": "#D99AA6"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#9FB8D7",
    "interface": "#9FB8D7",
    "enum": "#9FB8D7",
    "function": "#8DB6E8",
    "method": "#8DB6E8",
    "property": "#D7AA82",
    "variable.readonly": "#D7C28A",
    "parameter": "#D8DEE6",
    "keyword": "#8FB7C7"
  }
}
